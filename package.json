{
  "name": "fith",
  "version": "0.0.0",
  "description": "Pixel-faithful HTML to pure SVG conversion using a headless browser engine.",
  "type": "module",
  "bin": {
    "fith": "./dist/backends/node/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/backends/browser/index.d.ts",
      "default": "./dist/backends/browser/index.js"
    },
    "./outline": {
      "types": "./dist/outline.d.ts",
      "default": "./dist/outline.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:inject && tsc -p tsconfig.json",
    "build:extension": "tsx scripts/build-extension.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "render": "tsx scripts/render.ts",
    "validate": "tsx scripts/validate.ts",
    "validate:example": "tsx scripts/validate-example.ts",
    "bench": "tsx bench/run.ts",
    "bench:fetch": "tsx bench/fetch.ts",
    "inspect": "tsx scripts/inspect.ts",
    "bench:docs": "tsx bench/docs.ts",
    "bench:effects": "tsx bench/effects/lab.ts",
    "golden": "tsx scripts/golden.ts",
    "build:inject": "tsx scripts/build-inject.ts"
  },
  "keywords": [
    "html",
    "svg",
    "html-to-svg",
    "playwright",
    "render",
    "screenshot"
  ],
  "license": "MPL-2.0",
  "devDependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^20.0.0",
    "@types/opentype.js": "^1.3.9",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.47.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "opentype.js": "^2.0.0",
    "playwright": "^1.47.0"
  },
  "peerDependenciesMeta": {
    "opentype.js": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
