{
  "name": "fitting-html",
  "version": "0.0.0",
  "description": "Pixel-faithful HTML to pure SVG conversion using a headless browser engine.",
  "type": "module",
  "bin": {
    "fitting-html": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "html",
    "svg",
    "html-to-svg",
    "playwright",
    "render",
    "screenshot"
  ],
  "license": "MIT",
  "dependencies": {
    "opentype.js": "^1.3.4",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/opentype.js": "^1.3.8",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
